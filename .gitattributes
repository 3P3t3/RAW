# generated by site-src/build_homepage.py. never merge these: a merge keeps the
# current side untouched, and the post-merge hook rebuilds them from the merged source.
homepage.html merge=ours
category-*.html merge=ours
about.html merge=ours
/style.css merge=ours
# the CCRX copy under plus/ (PLUS_DIR in build_homepage.py). Its pages are already covered by the
# patterns above, which match at any depth; these two are the copy's own folder files. Rename the
# folder in build_homepage.py and these two lines move with it.
plus/index.html merge=ours
plus/site.webmanifest merge=ours
